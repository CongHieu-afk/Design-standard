{
  "_ghi_chu": "Token của dự án mẫu Rang Mộc (thương hiệu hư cấu). Dùng để minh hoạ cách khai báo, không phải bảng màu khuyến nghị cho dự án khác.",
  "color": {
    "primitive": {
      "ink-900": "#15181a",
      "ink-600": "#4a5157",
      "ink-500": "#6b7279",
      "ground": "#f3f4f1",
      "white": "#ffffff",
      "line": "#d5d8d3",
      "forest-700": "#11553f",
      "forest-50": "#e3eee9",
      "signal-700": "#b42318",
      "signal-50": "#fdecea",
      "amber-800": "#7a4a00",
      "amber-50": "#fff4df"
    },
    "bg": { "canvas": "{color.primitive.ground}", "surface": "{color.primitive.white}", "accent-soft": "{color.primitive.forest-50}", "danger-soft": "{color.primitive.signal-50}", "warn-soft": "{color.primitive.amber-50}" },
    "text": { "primary": "{color.primitive.ink-900}", "secondary": "{color.primitive.ink-600}", "on-accent": "{color.primitive.white}", "accent": "{color.primitive.forest-700}", "danger": "{color.primitive.signal-700}", "warn": "{color.primitive.amber-800}" },
    "border": { "control": "{color.primitive.ink-500}", "subtle": "{color.primitive.line}" },
    "action": { "primary": "{color.primitive.forest-700}" },
    "chart": { "line": "{color.primitive.ink-900}", "marker": "{color.primitive.signal-700}" }
  },
  "pairs": {
    "light": [
      { "fg": "{color.text.primary}", "bg": "{color.bg.canvas}" },
      { "fg": "{color.text.primary}", "bg": "{color.bg.surface}" },
      { "fg": "{color.text.secondary}", "bg": "{color.bg.canvas}" },
      { "fg": "{color.text.secondary}", "bg": "{color.bg.surface}" },
      { "fg": "{color.text.on-accent}", "bg": "{color.action.primary}" },
      { "fg": "{color.text.accent}", "bg": "{color.bg.surface}" },
      { "fg": "{color.text.accent}", "bg": "{color.bg.accent-soft}" },
      { "fg": "{color.text.danger}", "bg": "{color.bg.danger-soft}" },
      { "fg": "{color.text.warn}", "bg": "{color.bg.warn-soft}" },
      { "fg": "{color.border.control}", "bg": "{color.bg.surface}", "kind": "non-text" },
      { "fg": "{color.chart.marker}", "bg": "{color.bg.surface}", "kind": "non-text" },
      { "fg": "{color.action.primary}", "bg": "{color.bg.canvas}", "kind": "non-text" }
    ]
  }
}
